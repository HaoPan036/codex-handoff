{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/codex_handoff_hook.py\"",
            "timeout": 10,
            "statusMessage": "Restoring Codex compaction reminder state"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "^(manual|auto)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/codex_handoff_hook.py\"",
            "timeout": 10,
            "statusMessage": "Recording completed compaction"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/codex_handoff_hook.py\"",
            "timeout": 10,
            "statusMessage": "Finishing without automatic handoff"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/codex_handoff_hook.py\"",
            "timeout": 3,
            "statusMessage": "Closing Codex handoff lifecycle state"
          }
        ]
      }
    ]
  }
}
